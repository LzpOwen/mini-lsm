package(default_visibility = ["//visibility:public"])

# 核心引擎库。
# 头文件放在 include/ 下，以 "mlsm/xxx.h" 形式被引用（includes = ["include"] 提供 -Iinclude）。
# 新增源文件时，把它加进 srcs（glob 已自动覆盖 src/*.cc）。
cc_library(
    name = "mlsm",
    srcs = glob(["src/*.cc"]),
    hdrs = glob(["include/mlsm/*.h"]),
    includes = ["include"],
)

# 确定性 Raft 核心。只依赖 header-only 的 Status/Slice，不碰存储引擎，单独成库
# 保持依赖单向。src/*.cc 的单层 glob 不会误收 src/raft/，故 :mlsm 无需改动。
# storage.cc 是集成层（依赖 :mlsm），从核心 glob 里排除，见 :mlsm_raft_store。
cc_library(
    name = "mlsm_raft",
    srcs = glob(["src/raft/*.cc"], exclude = ["src/raft/storage.cc"]),
    hdrs = glob(["include/mlsm/raft/*.h"]),
    includes = ["include"],
)

# Raft 持久化集成层：连接 I/O-free 的 Raft 核心与存储引擎的 WAL/Env，故它是
# 唯一同时依赖 :mlsm 和 :mlsm_raft 的 raft 组件。
cc_library(
    name = "mlsm_raft_store",
    srcs = ["src/raft/storage.cc"],
    hdrs = ["include/mlsm/raft/storage.h"],
    includes = ["include"],
    deps = [
        ":mlsm",
        ":mlsm_raft",
    ],
)

cc_test(
    name = "mlsm_test",
    srcs = glob([
        "test/*.cc",
        "test/raft/*.cc",
    ]),
    deps = [
        ":mlsm",
        ":mlsm_raft",
        ":mlsm_raft_store",
        "@googletest//:gtest_main",
    ],
)

# 手动跑的性能工具，不进 test。用法：bazel run //:db_bench -- [num_entries]
cc_binary(
    name = "db_bench",
    srcs = ["bench/db_bench.cc"],
    deps = [":mlsm"],
)
